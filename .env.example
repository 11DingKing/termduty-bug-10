# Copy to .env and adjust. All values are examples only.
TERMDUTY_HTTP_ADDR=:57615
TERMDUTY_DATA_DIR=./data
TERMDUTY_DB_PATH=./data/termduty.db
TERMDUTY_SHARD_DIR=./data/shards
TERMDUTY_LOG_LEVEL=info
TERMDUTY_INGEST_INTERVAL=5s
TERMDUTY_EVAL_INTERVAL=10s
TERMDUTY_LEASE_INTERVAL=15s
TERMDUTY_LEASE_TTL=60s
TERMDUTY_DEFAULT_PAGE_SIZE=50
TERMDUTY_MAX_PAGE_SIZE=200
